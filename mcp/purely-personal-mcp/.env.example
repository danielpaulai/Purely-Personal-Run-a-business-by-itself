# Serverless hosting (Vercel): profiles must live somewhere that survives between requests.
# Run supabase/schema.sql once, then set both. Use the SERVICE ROLE key, server side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role...

# Local / stdio / a host with a persistent disk: SQLite is used automatically.
# PP_DB_PATH=/data/purely-personal.db

# Optional: lets generate_image render pictures (gpt-image-1). Without it you get an image brief.
# OPENAI_API_KEY=sk-...
